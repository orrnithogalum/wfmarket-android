<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Debug builds only. DUMP is held by the adb shell, so nothing else on the phone can call this. -->
        <receiver
            android:name=".DebugNotificationReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.wfmarket.app.DEBUG_NOTIFY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
