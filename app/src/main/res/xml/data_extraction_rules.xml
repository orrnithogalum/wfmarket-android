<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to a new phone. The session token is encrypted with a key that
     never leaves this phone's keystore, so it couldn't be read anywhere else, and the rest is a
     cache the app rebuilds from the site. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
